# ─────────────────────────────────────────────────────────────
# Eric Pablo Soluções Digitais — variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA versione o arquivo .env nem coloque chaves no frontend.
# ─────────────────────────────────────────────────────────────

# Banco PostgreSQL (produção: Neon, Supabase, Railway, RDS, VPS…)
# Para desenvolvimento sem instalar nada: `npm run db:local` e use a URL abaixo.
DATABASE_URL="postgresql://ep:ep_dev_password@localhost:5433/ep_digital?schema=public"

# Segredo usado para assinar as sessões (mín. 32 caracteres, aleatório).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# URL pública do site (sem barra no final). Usada em e-mails, sitemap e Open Graph.
APP_URL="http://localhost:3000"

# Administrador inicial criado por `npm run db:seed`
# (a senha precisa ter 10+ caracteres; troque-a no primeiro acesso).
ADMIN_NAME="Eric Pablo"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Pagamentos ───────────────────────────────────────────────
# manual  → PIX manual: o cliente paga na sua chave PIX (QR Code + copia e cola gerados
#           automaticamente) e você confirma o pagamento no painel. Recomendado para começar.
# sandbox → SOMENTE TESTES: permite "simular" pagamento aprovado (bloqueado com NODE_ENV=production
#           a menos que ALLOW_SANDBOX_IN_PRODUCTION="true").
# Para integrar um gateway (Mercado Pago, Asaas, Stripe…), veja src/services/payments/README.md.
PAYMENT_PROVIDER="manual"
# Segredo para validar webhooks do gateway (HMAC). Nunca exponha no frontend.
PAYMENT_WEBHOOK_SECRET=""

# ── E-mail (recuperação de senha e avisos) ───────────────────
# Se SMTP_HOST estiver vazio, os e-mails são apenas registrados no console (modo desenvolvimento).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Eric Pablo Soluções Digitais <contato@seudominio.com.br>"

# ── Arquivos ─────────────────────────────────────────────────
# Pasta de uploads (imagens públicas) e arquivos privados de produtos digitais — usada quando
# BLOB_READ_WRITE_TOKEN (abaixo) NÃO está definido. Em VPS/Docker, aponte para um volume persistente.
UPLOAD_DIR="./storage"

# Vercel: ative "Storage → Blob" no projeto e a Vercel preenche esta variável sozinha — não defina
# manualmente. Quando ela existe, os uploads vão para a Blob em vez do disco (que não persiste na Vercel).
BLOB_READ_WRITE_TOKEN=""

# ── Docker Compose (publicação em VPS) ───────────────────────
# Senha do PostgreSQL do container (use só letras e números). O docker-compose.yml monta a DATABASE_URL sozinho.
POSTGRES_PASSWORD=""
